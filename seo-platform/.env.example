# Copy this file to .env (and to app/.env for local `npm run dev`/`npm run
# worker` outside Docker) and fill in real values. Never commit the real
# .env file.

# Postgres connection string used by the Next.js app, drizzle-kit, and the
# pg-boss worker. Inside Docker Compose, host is the `postgres` service
# name; running the app on your host against the Compose Postgres, use
# 127.0.0.1 and the port published in docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/seo_platform

# Better Auth's session/cookie signing secret. Generate a real one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

# Public URL Better Auth uses to build absolute links (callbacks, etc).
BETTER_AUTH_URL=http://localhost:3000

# Local Ollama server for AI features (added in Phase 4). The app must
# work with this unset/unreachable — Ollama is optional, never mandatory.
OLLAMA_BASE_URL=http://ollama:11434

# Phase 5: how many crawl-website jobs a single worker process runs at
# once (pg-boss localConcurrency). Each is a real siteone-crawler
# subprocess, so keep this modest on a small box. Default 2 if unset.
WORKER_CONCURRENCY=2

# Phase 5, optional: SMTP connection string (smtp://user:pass@host:port)
# for the notifier's email leg. Leave unset — the in-app notifications
# row the dashboard shows is always written regardless of this; email is
# a no-op (never a failure, never required) when SMTP_URL isn't set.
# SMTP_URL=
# SMTP_FROM=seo-platform@yourdomain.example

# Phase 5, optional: minimum interval between *scheduled* (not manual)
# crawls of the same website, in milliseconds, regardless of how
# aggressive its cron cadence is. Default 6 hours if unset.
# SCHEDULED_CRAWL_MIN_INTERVAL_MS=21600000

NODE_ENV=production
PORT=3000
