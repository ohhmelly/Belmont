# Copy this file to .env and fill in real values for your environment.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/seo_platform
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
OLLAMA_BASE_URL=http://localhost:11434
NODE_ENV=development
PORT=3000

# --- Stripe (Phase 6 billing) -----------------------------------------
# TEST MODE ONLY — replace with real keys only with explicit owner
# approval before going live. STRIPE_SECRET_KEY must start with
# "sk_test_"; src/lib/billing/stripe-client.ts actively refuses to start
# a client with a key that looks like a live key (sk_live_/rk_live_),
# so this app cannot accept a real payment even by accident.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# From the Stripe CLI (`stripe listen --print-secret`) or your test-mode
# webhook endpoint's settings page. Required to verify webhook
# signatures — see src/app/api/stripe/webhook/route.ts.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Test-mode Stripe Price ids for each paid plan (see src/lib/plans/limits.ts
# for what each tier includes). Create these as test-mode prices in the
# Stripe dashboard; never point these at live-mode prices.
STRIPE_PRICE_STARTER=price_REPLACE_ME_TEST_STARTER
STRIPE_PRICE_PROFESSIONAL=price_REPLACE_ME_TEST_PROFESSIONAL
STRIPE_PRICE_AGENCY=price_REPLACE_ME_TEST_AGENCY
